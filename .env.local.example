# Anthropic API Configuration
# Copy this file to .env.local and fill in your actual API key

# Your Anthropic API Key (get it from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-v1-...

# Optional: Model override (default: claude-haiku-4-5-20251001)
# Supported models:
#   - claude-haiku-4-5-20251001 (recommended - fast, affordable)
#   - claude-sonnet-5-5
#   - claude-opus-5-5
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional: API request timeout (seconds)
CLAUDE_TIMEOUT=30

# Optional: Enable detailed Claude logging
CLAUDE_DEBUG=false

# Optional: Max tokens per request
CLAUDE_MAX_TOKENS=2048
